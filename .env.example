# --- Supabase — Project Settings → API -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# service_role: ATRAVIESA la RLS.
# Solo en servidor. Jamás en el cliente, jamás en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Solo para migraciones (npm run migrate). Supabase → Connect → Session pooler.
# Si tu red bloquea el 5432, usa el 6543.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-us-east-2.pooler.supabase.com:6543/postgres

# --- AssemblyAI — transcripción de notas de voz ------------------------------
# assemblyai.com → API Keys
ASSEMBLYAI_API_KEY=

# --- WhatsApp Business Platform (opcional) ----------------------------------
# El demo funciona sin esto: el grabador del navegador usa el mismo pipeline.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
